#Creating R
cells = sorted(data['combined_dummies'].unique())
age = np.array([int(c[1:3]) for c in cells])
edu = np.array([int(c[3:5]) for c in cells])

# 30 x 4 matrix: one row per cell, columns are 1, education, age, education*age
Z = np.column_stack([np.ones(30),edu ,age ,edu*age ])

# anchors: four corners of a rectangle,
anchor_cells = [(12, 26), (12, 27), (13, 26), (13, 27)]
anchor_idx = [cells.index(f'd{a}{e}') for e, a in anchor_cells]

Z_anchor = Z[anchor_idx, :]                       # 4 x 4
Z_anchor_inv = np.linalg.inv(Z_anchor)

rows = []
for c in range(30):
    if c in anchor_idx:
        continue
    r = np.zeros(30)
    r[c] = -1                            
    r[anchor_idx] = Z[c,:] @ Z_anchor_inv             
    rows.append(r)

R = np.array(rows)
q = np.zeros((26,1))

print(Z_anchor)
print(Z_anchor_inv)
print(R.shape)                           
print(np.abs(R @ Z).max())              
print(np.linalg.matrix_rank(R))             
print(R)

# the 30 coefficients
alpha_hat = unrestricted_model.params.values

# estimated covariance matrix of alpha_hat
V = unrestricted_model.cov_params().values
q = np.zeros(26)
# how far the data are from satisfying the restrictions: R alpha_hat - q
gap = R @ alpha_hat - q

# the variance under null
middle = R @ V @ R.T

# F
F = gap @ np.linalg.inv(middle) @ gap / 26

p_value = stats.f.sf(F,26, 868)     # numerator df, denominator df

